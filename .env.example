# Copy this file to .env and fill in your own credentials.
# Never commit .env.

# USDA NASS Quick Stats API key.
# Request a free key at: https://quickstats.nass.usda.gov/api
NASS_API_KEY=replace-with-your-nass-api-key

# Optional Google Earth Engine Cloud project ID.
# Create/select a Google Cloud project with Earth Engine enabled.
# See: https://developers.google.com/earth-engine/guides/access
GEE_PROJECT=replace-with-your-gee-project-id

# Optional local paths and years.
BENCHMARK_DATA_DIR=USA_data/benchmark
BENCHMARK_START_YEAR=2000
BENCHMARK_END_YEAR=2025
